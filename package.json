{
  "name": "turborepo-ui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "clean": "turbo run clean && rm -rf node_modules dist",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=@mtrangio/ui && echo \"Releasing packages...\" && changeset publish",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
